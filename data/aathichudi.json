{
  "work": "ஆத்திச்சூடி",
  "author": "ஔவையார் (Project Madurai source attribution)",
  "sourceUrl": "https://www.projectmadurai.org/pm_etexts/utf8/pmuni0002.html",
  "sourceEdition": "Project Madurai Unicode pmuni0002; 2001 e-text page; attribution header retained in source snapshot",
  "sourceSnapshot": "data/source_snapshots/project_madurai_pmuni0002.html",
  "sourceSha256": "fff843f5609b4ce9dbfc728a8e65cee1a929f8bc40bca93424479ee7544529e3",
  "licenseNote": "Project Madurai source header permits free distribution when the header is retained; see bundled snapshot.",
  "items": [
    {
      "number": 1,
      "text": "அறம் செய விரும்பு.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 2,
      "text": "ஆறுவது சினம்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 3,
      "text": "இயல்வது கரவேல்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 4,
      "text": "ஈவது விலக்கேல்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 5,
      "text": "உடையது விளம்பேல்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 6,
      "text": "ஊக்கமது கைவிடேல்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 7,
      "text": "எண் எழுத்து இகழேல்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 8,
      "text": "ஏற்பது இகழ்ச்சி.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 9,
      "text": "ஐயம் இட்டு உண்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 10,
      "text": "ஒப்புரவு ஒழுகு.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 11,
      "text": "ஓதுவது ஒழியேல்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 12,
      "text": "ஔவியம் பேசேல்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 13,
      "text": "அஃகம் சுருக்கேல்.",
      "group": "உயிர் வருக்கம்"
    },
    {
      "number": 14,
      "text": "கண்டொன்று சொல்லேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 15,
      "text": "ஙப் போல் வளை.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 16,
      "text": "சனி நீராடு.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 17,
      "text": "ஞயம்பட உரை.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 18,
      "text": "இடம்பட வீடு எடேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 19,
      "text": "இணக்கம் அறிந்து இணங்கு.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 20,
      "text": "தந்தை தாய்ப் பேண்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 21,
      "text": "நன்றி மறவேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 22,
      "text": "பருவத்தே பயிர் செய்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 23,
      "text": "மண் பறித்து உண்ணேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 24,
      "text": "இயல்பு அலாதன செய்யேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 25,
      "text": "அரவம் ஆட்டேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 26,
      "text": "இலவம் பஞ்சில் துயில்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 27,
      "text": "வஞ்சகம் பேசேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 28,
      "text": "அழகு அலாதன செய்யேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 29,
      "text": "இளமையில் கல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 30,
      "text": "அரனை மறவேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 31,
      "text": "அனந்தல் ஆடேல்.",
      "group": "உயிர்மெய் வருக்கம்"
    },
    {
      "number": 32,
      "text": "கடிவது மற.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 33,
      "text": "காப்பது விரதம்.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 34,
      "text": "கிழமைப்பட வாழ்.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 35,
      "text": "கீழ்மை அகற்று.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 36,
      "text": "குணமது கைவிடேல்.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 37,
      "text": "கூடிப் பிரியேல்.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 38,
      "text": "கெடுப்பது ஒழி.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 39,
      "text": "கேள்வி முயல்.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 40,
      "text": "கைவினை கரவேல்.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 41,
      "text": "கொள்ளை விரும்பேல்.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 42,
      "text": "கோதாட்டு ஒழி.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 43,
      "text": "கௌவை அகற்று.",
      "group": "ககர வருக்கம்"
    },
    {
      "number": 44,
      "text": "சக்கர நெறி நில்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 45,
      "text": "சான்றோர் இனத்து இரு.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 46,
      "text": "சித்திரம் பேசேல்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 47,
      "text": "சீர்மை மறவேல்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 48,
      "text": "சுளிக்கச் சொல்லேல்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 49,
      "text": "சூது விரும்பேல்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 50,
      "text": "செய்வன திருந்தச் செய்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 51,
      "text": "சேரிடம் அறிந்து சேர்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 52,
      "text": "சையெனத் திரியேல்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 53,
      "text": "சொற் சோர்வு படேல்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 54,
      "text": "சோம்பித் திரியேல்.",
      "group": "சகர வருக்கம்"
    },
    {
      "number": 55,
      "text": "தக்கோன் எனத் திரி.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 56,
      "text": "தானமது விரும்பு.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 57,
      "text": "திருமாலுக்கு அடிமை செய்.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 58,
      "text": "தீவினை அகற்று.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 59,
      "text": "துன்பத்திற்கு இடம் கொடேல்.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 60,
      "text": "தூக்கி வினை செய்.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 61,
      "text": "தெய்வம் இகழேல்.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 62,
      "text": "தேசத்தோடு ஒட்டி வாழ்.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 63,
      "text": "தையல் சொல் கேளேல்.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 64,
      "text": "தொன்மை மறவேல்.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 65,
      "text": "தோற்பன தொடரேல்.",
      "group": "தகர வருக்கம்"
    },
    {
      "number": 66,
      "text": "நன்மை கடைப்பிடி.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 67,
      "text": "நாடு ஒப்பன செய்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 68,
      "text": "நிலையில் பிரியேல்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 69,
      "text": "நீர் விளையாடேல்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 70,
      "text": "நுண்மை நுகரேல்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 71,
      "text": "நூல் பல கல்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 72,
      "text": "நெற்பயிர் விளைவு செய்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 73,
      "text": "நேர்பட ஒழுகு.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 74,
      "text": "நைவினை நணுகேல்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 75,
      "text": "நொய்ய உரையேல்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 76,
      "text": "நோய்க்கு இடம் கொடேல்.",
      "group": "நகர வருக்கம்"
    },
    {
      "number": 77,
      "text": "பழிப்பன பகரேல்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 78,
      "text": "பாம்பொடு பழகேல்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 79,
      "text": "பிழைபடச் சொல்லேல்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 80,
      "text": "பீடு பெற நில்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 81,
      "text": "புகழ்ந்தாரைப் போற்றி வாழ்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 82,
      "text": "பூமி திருத்தி உண்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 83,
      "text": "பெரியாரைத் துணைக் கொள்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 84,
      "text": "பேதைமை அகற்று.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 85,
      "text": "பையலோடு இணங்கேல்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 86,
      "text": "பொருள்தனைப் போற்றி வாழ்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 87,
      "text": "போர்த் தொழில் புரியேல்.",
      "group": "பகர வருக்கம்"
    },
    {
      "number": 88,
      "text": "மனம் தடுமாறேல்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 89,
      "text": "மாற்றானுக்கு இடம் கொடேல்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 90,
      "text": "மிகைபடச் சொல்லேல்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 91,
      "text": "மீதூண் விரும்பேல்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 92,
      "text": "முனைமுகத்து நில்லேல்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 93,
      "text": "மூர்க்கரோடு இணங்கேல்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 94,
      "text": "மெல்லி நல்லாள் தோள்சேர்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 95,
      "text": "மேன்மக்கள் சொல் கேள்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 96,
      "text": "மை விழியார் மனை அகல்.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 97,
      "text": "மொழிவது அற மொழி.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 98,
      "text": "மோகத்தை முனி.",
      "group": "மகர வருக்கம்"
    },
    {
      "number": 99,
      "text": "வல்லமை பேசேல்.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 100,
      "text": "வாது முற்கூறேல்.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 101,
      "text": "வித்தை விரும்பு.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 102,
      "text": "வீடு பெற நில்.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 103,
      "text": "உத்தமனாய் இரு.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 104,
      "text": "ஊருடன் கூடி வாழ்.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 105,
      "text": "வெட்டெனப் பேசேல்.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 106,
      "text": "வேண்டி வினை செயேல்.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 107,
      "text": "வைகறைத் துயில் எழு.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 108,
      "text": "ஒன்னாரைத் தேறேல்.",
      "group": "வகர வருக்கம்"
    },
    {
      "number": 109,
